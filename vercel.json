{
  "version": 2,
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.4", "maxDuration": 30 },
    "api/classify.py": {
      "includeFiles": "python/{predict.py,model_random_forest.pkl}",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/classify", "dest": "/api/classify.py" },
    { "src": "/(.*\\.(?:css|js|png|jpg|jpeg|webp|svg|ico|glb|woff2?))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_LOCALE": "id",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "DB_CONNECTION": "mysql"
  }
}